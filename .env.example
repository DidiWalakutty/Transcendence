# Copy to `.env` (ignored by git) and adjust. Every value below is a localhost
# default; production deployments must set BETTER_AUTH_SECRET, POSTGRES_PASSWORD
# and the SEED_* passwords to real secrets.

## BACKEND
NODE_ENV=production
DATABASE_URL=postgres://transcendence:transcendence@localhost:5432/transcendence
PORT=3001
REDIS_URL=redis://localhost:6380
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-in-production
BETTER_AUTH_URL=http://localhost:3001
SEED_ADMIN_PASSWORD=Transcendence123!
SEED_DIDI_PASSWORD=didi-password
SEED_HOMER_PASSWORD=homer-password
SEED_ADMIN_EMAIL=admin.eventra@gmail.com
SEED_DIDI_EMAIL=didi@example.com
SEED_HOMER_EMAIL=homer@example.com
SEED_ADMIN_USERNAME=admin
SEED_DIDI_USERNAME=didi_walakutty
SEED_HOMER_USERNAME=homer_simpson
CACHE_TTL_MS=30000
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100
THROTTLE_ENABLED=false
DEV_FIXTURES=false
CORS_ORIGINS=http://localhost:3000

## Docker compose options
POSTGRES_DB=transcendence
POSTGRES_USER=transcendence
POSTGRES_PASSWORD=transcendence
PUBLIC_ORIGIN=https://localhost:3000
HTTP_PORT=3080
HTTPS_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6380
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM='"Eventra Team" <no-reply@eventra.local>'
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
