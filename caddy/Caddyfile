{
    # Rootless Docker (e.g. Codam machines) can't bind ports below 1024, so the
    # ports are configurable. Caddy has to know the real numbers itself so the
    # HTTP -> HTTPS redirect points at the right port.
    http_port {$HTTP_PORT:80}
    https_port {$HTTPS_PORT:443}
}

# Explicit redirect instead of Caddy's automatic one, which drops the port.
http://localhost {
    redir https://localhost:{$HTTPS_PORT:443}{uri} permanent
}

https://localhost {
    tls /certs/local.pem /certs/local-key.pem

    reverse_proxy /api/* backend:3001
    reverse_proxy /* frontend:3000
}
