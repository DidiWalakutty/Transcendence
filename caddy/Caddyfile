{
    # Ports above 1024 by default because rootless Docker (Codam machines)
    # can't bind lower ones. Caddy has to know the real numbers itself so the
    # HTTP -> HTTPS redirect points at the right port.
    http_port {$HTTP_PORT:3080}
    https_port {$HTTPS_PORT:3000}
}

# Explicit redirect instead of Caddy's automatic one, which drops the port.
http://localhost {
    redir https://localhost:{$HTTPS_PORT:3000}{uri} permanent
}

https://localhost {
    # Written at container start by the `command` in docker-compose.yml:
    # `tls /certs/local.pem /certs/local-key.pem` when a certificate is present
    # in caddy/certs (ignored by git), otherwise `tls internal` so Caddy signs
    # its own. No private key is committed either way.
    import /etc/caddy/tls.caddy

    reverse_proxy /api/* backend:3001
    reverse_proxy /* frontend:3000
}
