{
  "name": "ft_transcendence",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "vp run -r --parallel dev",
    "dev:frontend": "vp run --filter @repo/frontend --fail-if-no-match --parallel dev",
    "dev:backend": "vp run --filter @repo/backend --fail-if-no-match --parallel dev",
    "build": "vp run -r build",
    "build:frontend": "vp run --filter @repo/frontend --fail-if-no-match build",
    "build:backend": "vp run --filter @repo/backend --fail-if-no-match build",
    "test": "vp test",
    "test:frontend": "vp test --project frontend",
    "test:backend": "vp test --project backend",
    "test:backend:e2e": "vp test --project backend test/app.e2e-spec.ts",
    "check": "vp check",
    "check:frontend": "vp check apps/frontend",
    "check:backend": "vp check apps/backend",
    "check:fix": "vp check --fix",
    "check:fix:frontend": "vp check --fix apps/frontend",
    "check:fix:backend": "vp check --fix apps/backend",
    "lint": "vp lint",
    "lint:frontend": "vp lint apps/frontend",
    "lint:backend": "vp lint apps/backend",
    "fmt": "vp fmt",
    "fmt:frontend": "vp fmt apps/frontend --check",
    "fmt:backend": "vp fmt apps/backend --check",
    "fmt:fix": "vp fmt --write",
    "fmt:fix:frontend": "vp fmt apps/frontend --write",
    "fmt:fix:backend": "vp fmt apps/backend --write",
    "staged": "vp staged",
    "prepare": "vp config --no-agent"
  },
  "devDependencies": {
    "vite-plus": "^0.2.0"
  },
  "packageManager": "bun@1.3.14"
}
