{
  "name": "ft_transcendence",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "vp run -w repo:dev",
    "dev:frontend": "vp run -w repo:dev:frontend",
    "dev:backend": "vp run -w repo:dev:backend",
    "build": "vp run -w repo:build",
    "build:frontend": "vp run -w repo:build:frontend",
    "build:backend": "vp run -w repo:build:backend",
    "test": "vp run -w repo:test",
    "test:frontend": "vp run -w repo:test:frontend",
    "test:backend": "vp run -w repo:test:backend",
    "test:backend:e2e": "vp run -w repo:test:backend:e2e",
    "check": "vp run -w repo:check",
    "check:frontend": "vp run -w repo:check:frontend",
    "check:backend": "vp run -w repo:check:backend",
    "check:fix": "vp run -w repo:check:fix",
    "check:fix:frontend": "vp run -w repo:check:fix:frontend",
    "check:fix:backend": "vp run -w repo:check:fix:backend",
    "lint": "vp run -w repo:lint",
    "lint:frontend": "vp run -w repo:lint:frontend",
    "lint:backend": "vp run -w repo:lint:backend",
    "fmt": "vp fmt",
    "fmt:frontend": "vp fmt apps/frontend --check",
    "fmt:backend": "vp fmt apps/backend --check",
    "fmt:fix": "vp fmt --write",
    "fmt:fix:frontend": "vp fmt apps/frontend --write",
    "fmt:fix:backend": "vp fmt apps/backend --write",
    "trpc:generate": "vp run -w repo:trpc:generate",
    "trpc:watch": "vp run -w repo:trpc:watch",
    "staged": "vp run -w repo:staged",
    "prepare": "vp config --no-agent"
  },
  "devDependencies": {
    "@repo/tsconfig": "workspace:*",
    "vite-plus": "^0.2.0"
  },
  "packageManager": "bun@1.3.14"
}
