# Localhost defaults for `vp run dev`. Nothing in here is secret: the auth
# secret is a labelled placeholder and the SEED_* values are the documented
# demo logins. Real values belong in an ignored `.env` (see .env.example).
DATABASE_URL=postgres://transcendence:transcendence@localhost:5432/transcendence
REDIS_URL=redis://localhost:6380
BETTER_AUTH_SECRET=dev-only-insecure-secret-change-in-production
BETTER_AUTH_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000
THROTTLE_ENABLED=false

MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USER=""
MAIL_PASS=""
